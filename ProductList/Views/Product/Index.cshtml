@model ProductList.Models.ProductViewModel

@{
    ViewBag.Title = "Product List";
}
<style>
    /* Hide scrollbar until height is exceeded */
    div[style*="max-height"]::-webkit-scrollbar {
        width: 0.5em;
    }

    div[style*="max-height"]::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.5);
        border-radius: 0.5em;
    }

    div[style*="max-height"]::-webkit-scrollbar-track {
        background-color: rgba(255, 255, 255, 0.1);
    }

    /* Make Edit & Delete the same width */
    #productTable .btn-edit,
    #productTable .btn-delete {
        display: inline-block;
        width: 70px; /* adjust to taste */
        text-align: center;
    }

    /* Make each column a vertical flex-container, and space items out */
    .align-form-cols > .col-md-6 {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
</style>
<br />
<div class="row align-form-cols">

    <!-- Column 1: Dropdowns -->
    <div class="col-md-6">
        <div class="mb-3">
            <label for="supplierDropdown" class="form-label">Supplier:</label>
            @Html.DropDownListFor(model => model.SelectedSupplierId,
                                                                                      new SelectList(Model.Suppliers, "Id", "Name"),
                                                                                      "Select a supplier",
                                                                                      new
                                                                                      {
                                                                                          id = "supplierDropdown",
                                                                                          @class = "form-select"
                                                                                      })
        </div>
        <div class="mb-3">
            <label for="categoryDropdown" class="form-label">Category:</label>
            @Html.DropDownListFor(model => model.SelectedCategoryId,
                                                                                      new SelectList(Model.Categories, "Id", "Name"),
                                                                                      "Select a category",
                                                                                      new
                                                                                      {
                                                                                          id = "categoryDropdown",
                                                                                          @class = "form-select",
                                                                                          disabled = "disabled"
                                                                                      })
        </div>
        <div class="mb-3">
            <label for="productDropdown" class="form-label">Product:</label>
            @Html.DropDownListFor(model => model.SelectedProductId,
                                                                                      Enumerable.Empty<SelectListItem>(),
                                                                                      "Select a product",
                                                                                      new
                                                                                      {
                                                                                          id = "productDropdown",
                                                                                          @class = "form-select",
                                                                                          disabled = "disabled"
                                                                                      })
        </div>
    </div>

    <!-- Column 2: Serial, Value, Add Button -->
    <div class="col-md-6">
        <div class="mb-3">
            <label for="serialTextbox" class="form-label">Serial:</label>
            <input type="text" id="serialTextbox" class="form-control" placeholder="Only numbers are allowed" disabled />
            <small class="text-danger" style="display:none;">Only numeric values are allowed.</small>
        </div>
        <div class="mb-3">
            <label for="productNameTextbox" class="form-label">Value:</label>
            <input type="text" id="productNameTextbox" class="form-control" placeholder="Only numbers are allowed" disabled />
        </div>
        <div class="mb-3 d-grid gap-2">
            <input type="button" id="addProductButton" value="Add" class="btn btn-primary" />
        </div>
    </div>
</div>

<!-- Product Table Section -->
<div style="height: 300px; overflow-y: scroll;">
    <table class="table table-condensed" id="productTable">
        <thead style="position: sticky; top: 0; background-color: lightgrey;">
            <tr>
                <th style="width: 5%;">ID</th>
                <th style="width: 20%;">Supplier</th>
                <th style="width: 20%;">Category</th>
                <th style="width: 20%;">Product</th>
                <th style="width: 15%;">Serial</th>
                <th style="width: 10%;">Value</th>
                <th style="width: 20%;">Timestamp</th>
                <th style="width: 15%;">ACTION</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // INITIAL STATE
            $("#supplierDropdown").prop("disabled", false);
            $("#categoryDropdown, #productDropdown, #serialTextbox, #productNameTextbox, #addProductButton")
                .prop("disabled", true);

            // Utility resets
            function resetDown() {
                $("#categoryDropdown").val("").prop("disabled", true);
                resetMid();
            }
            function resetMid() {
                $("#productDropdown")
                    .empty()
                    .append('<option value="">Select a product</option>')
                    .prop("disabled", true);
                resetTail();
            }
            function resetTail() { $("#addProductButton").prop("disabled", true); }

            // 1) SUPPLIER → CATEGORY (Main form)
            $("#supplierDropdown").on("change", function () {
                var supplierId = $(this).val();
                resetDown();  // Reset everything downstream

                if (!supplierId) return;

                // Enable and populate category dropdown
                $("#categoryDropdown")
                    .prop("disabled", false)
                    .empty()
                    .append('<option value="">Select a category</option>');

                $.get('@Url.Action("GetCategoriesBySupplier", "Product")', { supplierId: supplierId })
                    .done(function (data) {
                        var parts = data.split(";"), names = parts[0].split(","), ids = parts[1].split(",");
                        for (var i = 0; i < names.length; i++) {
                            $("#categoryDropdown").append($('<option>').val(ids[i]).text(names[i]));
                        }
                    });
            });

    // Unified handler: supplier change in table row → reset & load categories
$("#productTable").on("change", "select[id$='_supplier']", function () {
  var $row = $(this).closest("tr");
  var rid = $row.attr("id");
  var supplierId = $(this).val();

  // Reset category dropdown
  var $cat = $("#" + rid + "_category");
  $cat.val("").prop("disabled", true).empty()
      .append('<option value="">Select a category</option>');

  // Reset product dropdown
  var $prod = $("#" + rid + "_product");
  $prod.val("").prop("disabled", true).empty()
      .append('<option value="">Select a product</option>');

  if (!supplierId) return;

  // Populate category dropdown from supplier
  $.get('@Url.Action("GetCategoriesBySupplier", "Product")', { supplierId: supplierId })
    .done(function (data) {
      var parts = data.split(";"),
          names = parts[0].split(","),
          ids = parts[1].split(",");
      for (var i = 0; i < names.length; i++) {
        $cat.append($('<option>').val(ids[i]).text(names[i]));
      }
      $cat.prop("disabled", false);
    });
});

    // Table-row category change → populate products via AJAX
    $("#productTable")
        .on(
            "change", "select[id$='_category']", function() {
              var $row = $(this).closest("tr");
              var rid = $row.attr("id");
              var $prod = $("#" + rid + "_product");
              var catId = $(this).val();

              $prod.empty()
                  .append('<option value="">Select a product</option>')
                  .prop("disabled", true);
              if (!catId) return;

              $.get('@Url.Action("GetProductsByCategory","Product")',
                    {categoryId : catId})
                  .done(function(data) {
                    var parts = data.split(";"), names = parts[0].split(","),
                        ids = parts[1].split(",");
                    for (var i = 0; i < names.length; i++) {
                      $prod.append($('<option>').val(ids[i]).text(names[i]));
                    }
                    $prod.prop("disabled", false);
                  });
            });

    // 2) CATEGORY → PRODUCT (AJAX)
    $("#categoryDropdown")
        .on(
            "change", function() {
              var catId = $(this).val();
              resetMid();
              if (!catId) return;
              $.get('@Url.Action("GetProductsByCategory","Product")',
                    {categoryId : catId})
                  .done(function(data) {
                    var parts = data.split(";"), names = parts[0].split(","),
                        ids = parts[1].split(",");
                    for (var i = 0; i < names.length; i++) {
                      $("#productDropdown")
                          .append($('<option>').val(ids[i]).text(names[i]));
                    }
                    $("#productDropdown").prop("disabled", false);
                  });
            });

    // 3) PRODUCT → SERIAL
    $("#productDropdown")
        .on(
            "change", function() {
              resetTail();
              if ($(this).val()) {
                $("#serialTextbox").prop("disabled", false).focus();
              }
            });

            // 4) SERIAL → VALUE
            $("#serialTextbox")
                .on(
                    "input", function () {
                        var v = this.value.replace(/\D/g, '').slice(0, 10); // Fixed regex
                        $(this).val(v);
                        if (v) {
                            $("#productNameTextbox").prop("disabled", false);
                        } else {
                            $("#productNameTextbox").prop("disabled", true);
                            $("#addProductButton").prop("disabled", true);
                        }
                    }
                );

            // 5) VALUE → ADD
            $("#productNameTextbox")
                .on(
                    "input", function () {
                        var v = this.value.replace(/\D/g, '').slice(0, 6); // Fixed regex
                        $(this).val(v);
                        $("#addProductButton").prop("disabled", !v);
                    }
                ); // Added missing semicolon

    // 6) ADD ROW with unique IDs
    var rowCount = 0;
    $("#addProductButton")
        .on(
            "click", function() {
              rowCount++;
              var rowId = 'row_' + rowCount,
                  supplier = $("#supplierDropdown option:selected").text(),
                  catVal = $("#categoryDropdown").val(),
                  catText = $("#categoryDropdown option:selected").text(),
                  prodVal = $("#productDropdown").val(),
                  prodText = $("#productDropdown option:selected").text(),
                  serial = $("#serialTextbox").val(),
                  value = $("#productNameTextbox").val(),
                  time = new Date().toLocaleString();

              // Clone full option sets so in-row dropdowns are complete
              var $suppClone = $("#supplierDropdown")
                                   .clone()
                                   .attr("id", rowId + "_supplier")
                                   .addClass("form-select")
                                   .prop("disabled", true)
                                   .val($("#supplierDropdown").val());
              var $catClone = $("#categoryDropdown")
                                  .clone()
                                  .attr("id", rowId + "_category")
                                  .addClass("form-select")
                                  .prop("disabled", true)
                                  .val(catVal);
              var $prodClone = $("#productDropdown")
                                   .clone()
                                   .attr("id", rowId + "_product")
                                   .addClass("form-select")
                                   .prop("disabled", true)
                                   .val(prodVal);

              // Create serial + value inputs with unique IDs
              var $serialIn = $('<input>')
                                  .attr({
                                    type : 'text',
                                    maxlength : 10,
                                    id : rowId + '_serial'
                                  })
                                  .addClass('form-control')
                                  .prop('disabled', true)
                                  .val(serial);
              var $valueIn =
                  $('<input>')
                      .attr(
                          {type : 'text', maxlength : 6, id : rowId + '_value'})
                      .addClass('form-control')
                      .prop('disabled', true)
                      .val(value);

              // Build row
              var $tr =
                  $('<tr>')
                      .attr('id', rowId)
                      .append($('<td>').text(
                          rowCount))  // Unique numeric ID in first column
                      .append($('<td>').append($suppClone))
                      .append($('<td>').append($catClone))
                      .append($('<td>').append($prodClone))
                      .append($('<td>').append($serialIn))
                      .append($('<td>').append($valueIn))
                      .append($('<td>').text(time))
                      .append($('<td>').append(
                          $('<button>')
                              .addClass('btn btn-sm btn-edit btn-primary')
                              .text('Edit'),
                          ' ',
                          $('<button>')
                              .addClass('btn btn-sm btn-delete btn-danger')
                              .text('Delete')));

              $("#productTable tbody").append($tr);

              // Reset main form
              $("#supplierDropdown").val('');
              resetDown();
            });

    // 7) EDIT ↔ SAVE per-row, targeting the new IDs
    $("#productTable")
        .on(
            "click", ".btn-edit", function() {
              var $btn = $(this), $row = $btn.closest("tr"),
                  rid = $row.attr("id"), mode = $btn.text();

                if (mode === "Edit") {
                    // Reset all downstream fields
                    $("#" + rid + "_category, #" + rid + "_product")
                        .val("")
                        .prop("disabled", true);

                    // Enable only the supplier initially; others will enable based on change
                    $("#" + rid + "_supplier, #" + rid + "_serial, #" + rid + "_value")
                        .prop("disabled", false);

                    $btn.text("Save")
                        .removeClass("btn-primary")
                        .addClass("btn-success");
                } else {
                    // Validation: Ensure all fields are populated
                    let supplier = $("#" + rid + "_supplier").val(),
                        category = $("#" + rid + "_category").val(),
                        product = $("#" + rid + "_product").val(),
                        serial = $("#" + rid + "_serial").val().trim(),
                        value = $("#" + rid + "_value").val().trim();

                    if (!supplier || !category || !product || !serial || !value) {
                        alert("Please ensure all fields are filled out before saving.");
                        return;
                    }

                    // Disable all fields on save
                    $("#" + rid + "_supplier, #" + rid + "_category, #" + rid + "_product, #" + rid + "_serial, #" + rid + "_value")
                        .prop("disabled", true);

                    $btn.text("Edit")
                        .removeClass("btn-success")
                        .addClass("btn-primary");
                }

            });

    // 8) DELETE per-row
    $("#productTable")
        .on(
            "click", ".btn-delete",
            function() { $(this).closest("tr").remove(); });

  });
    </script>
}